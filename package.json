{
  "name": "concord",
  "version": "1.0.18",
  "private": true,
  "description": "Chat, chamada de voz, vídeo e compartilhamento de tela para os amigos",
  "author": "Leonardo",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "servidor": "node server.js",
    "dev": "node --watch server.js",
    "dist": "electron-builder --win --publish never",
    "lancar": "npm version patch && git push --follow-tags",
    "test": "node tests/servidor.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "com.leonardoneri.concord",
    "productName": "Concord",
    "files": [
      "public/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Concord",
      "artifactName": "Concord-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "leonardoneri",
        "repo": "Concord",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
